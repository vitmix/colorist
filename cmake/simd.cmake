include(CheckCXXCompilerFlag)
include(CheckCXXSourceCompiles)
include(CheckCXXSourceRuns)
include(CMakePushCheckState)

option(COLORIST_NATIVE_SIMD "Select SIMD for the local CPU in native builds" ON)

function(colorist_cpu_supports feature result)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_INCLUDES ${OpenCV_INCLUDE_DIRS})
    set(CMAKE_REQUIRED_LIBRARIES opencv_core)
    if(MINGW)
        set(CMAKE_REQUIRED_LINK_OPTIONS -static)
    endif()
    # Repeat discovery on reconfiguration rather than retaining another host's result.
    unset(${result} CACHE)
    check_cxx_source_runs("#include <opencv2/core.hpp>
        int main() { return cv::checkHardwareSupport(${feature}) ? 0 : 1; }" ${result})
    set(${result} "${${result}}" PARENT_SCOPE)
    cmake_pop_check_state()
endfunction()

function(colorist_select_simd target)
    # AArch64 and toolchains already targeting NEON need no extra compiler flag.
    cmake_push_check_state(RESET)
    check_cxx_source_compiles("
        #if !defined(__ARM_NEON) && !defined(__ARM_NEON__) && !defined(_M_ARM64) && !defined(_M_ARM64EC)
        #error NEON is not enabled by this toolchain
        #endif
        int main() { return 0; }" COLORIST_TOOLCHAIN_NEON)
    cmake_pop_check_state()
    set(simd baseline)
    if(COLORIST_TOOLCHAIN_NEON)
        set(simd NEON)
    elseif(COLORIST_NATIVE_SIMD AND NOT CMAKE_CROSSCOMPILING)
        # Run baseline code: checking the CPU must not itself require AVX2 or NEON.
        colorist_cpu_supports(CV_CPU_AVX2 COLORIST_CPU_AVX2)
        if(COLORIST_CPU_AVX2)
            if(MSVC)
                set(flag /arch:AVX2)
            else()
                set(flag -mavx2)
            endif()
            check_cxx_compiler_flag("${flag}" COLORIST_COMPILER_AVX2)
            if(COLORIST_COMPILER_AVX2)
                target_compile_options(${target} PRIVATE "${flag}")
                set(simd AVX2)
            endif()
        else()
            # 32-bit Raspberry Pi OS may default to an older ARM instruction set.
            colorist_cpu_supports(CV_CPU_NEON COLORIST_CPU_NEON)
            if(COLORIST_CPU_NEON)
                check_cxx_compiler_flag(-mfpu=neon COLORIST_COMPILER_NEON)
                if(COLORIST_COMPILER_NEON)
                    target_compile_options(${target} PRIVATE -mfpu=neon)
                    set(simd NEON)
                endif()
            endif()
        endif()
    endif()
    if(CMAKE_CROSSCOMPILING)
        message(STATUS "colorist SIMD: ${simd} (target toolchain; host CPU discovery skipped)")
    else()
        message(STATUS "colorist SIMD: ${simd}")
    endif()
endfunction()
