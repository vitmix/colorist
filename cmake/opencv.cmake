# Initial cache for the local OpenCV build: image processing and PNG I/O only.
set(BUILD_LIST "core,imgproc,imgcodecs" CACHE STRING "" FORCE)
set(CMAKE_CXX_STANDARD 17 CACHE STRING "" FORCE)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5 CACHE STRING "" FORCE)
set(OPENCV_CONFIG_INSTALL_PATH "lib/cmake/opencv4" CACHE STRING "" FORCE)
set(OPENCV_VCSVERSION "4.14.0" CACHE STRING "" FORCE)

foreach(option IN ITEMS
    BUILD_SHARED_LIBS BUILD_TESTS BUILD_PERF_TESTS BUILD_EXAMPLES
    BUILD_opencv_apps BUILD_opencv_gapi BUILD_JAVA BUILD_opencv_python2 BUILD_opencv_python3
    WITH_IPP WITH_ITT WITH_OPENCL WITH_OPENCLAMDBLAS WITH_OPENCLAMDFFT
    WITH_ADE WITH_EIGEN WITH_LAPACK WITH_VTK WITH_WIN32UI WITH_GTK WITH_DIRECTML
    WITH_TBB WITH_OPENMP WITH_HPX
    WITH_FFMPEG WITH_MSMF WITH_DSHOW WITH_GSTREAMER WITH_PROTOBUF
    WITH_JPEG WITH_TIFF WITH_WEBP WITH_OPENJPEG WITH_OPENEXR WITH_AVIF WITH_JASPER
    WITH_IMGCODEC_GIF WITH_IMGCODEC_HDR WITH_IMGCODEC_SUNRASTER WITH_IMGCODEC_PXM WITH_IMGCODEC_PFM)
    set(${option} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(option IN ITEMS WITH_PNG BUILD_PNG BUILD_ZLIB OPENCV_SKIP_CMAKE_ROOT_CONFIG WITH_PTHREADS_PF)
    set(${option} ON CACHE BOOL "" FORCE)
endforeach()
